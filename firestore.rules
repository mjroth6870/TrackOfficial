rules_version = '2';
// Security rules for Track Officials (hosted copy).
// Meet staff sign in with an email account. Officials who scan an access code are signed in as guests:
// a guest can work inside a meet whose id is in their code, but can't list or create meets.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staff() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    match /meets/{meetId} {
      allow get: if signedIn();
      allow list: if staff();
      allow create, delete: if staff();
      allow update: if signedIn();
      // days, maps, check-in and call marks, umpire calls, heat clears, finals, rulebook, posts, shoe checks
      match /{rest=**} {
        allow read, write: if signedIn();
      }
    }
    // shoe photos: anyone signed in can view; only the person who took one can remove it
    match /photos/{photoId} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
                    && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    // display names of meet staff, shown on umpire calls and results
    match /people/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
